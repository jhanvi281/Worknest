# ==============================================================================
# WorkNest Environment Configuration Template
# All VITE_* variables are embedded into the client-side JavaScript bundle.
# NEVER place private keys, database connection strings, or service-role keys here.
# ==============================================================================

# Supabase Project API URL (Found in Supabase Dashboard -> Project Settings -> API)
VITE_SUPABASE_URL=https://your-project-id.supabase.co

# Supabase Client Anon / Publishable Key (Found in Supabase Dashboard -> Project Settings -> API)
# Either VITE_SUPABASE_PUBLISHABLE_KEY or VITE_SUPABASE_ANON_KEY is accepted.
VITE_SUPABASE_PUBLISHABLE_KEY=your-supabase-anon-or-publishable-key

# Clerk Authentication (Found in Clerk Dashboard -> API Keys -> Publishable Key)
# Application ID: app_3LOEzTZ89ZmDHCa2BxXwtSrMd8w
VITE_CLERK_PUBLISHABLE_KEY=pk_test_your-clerk-publishable-key

# Clerk Backend Configuration (For Edge Functions / Webhooks)
# Set in Supabase Dashboard -> Project Settings -> Edge Functions -> Secrets
# CLERK_SECRET_KEY=sk_test_your-clerk-secret-key
# CLERK_WEBHOOK_SECRET=whsec_your-clerk-webhook-signing-secret

# Optional: Custom or Self-Hosted Jitsi Meet Domain (Defaults to meet.jit.si)
# Example for 8x8 JaaS: 8x8.vc or your custom deployed Jitsi instance
# VITE_JITSI_DOMAIN=meet.jit.si

# Optional: Public Application URL for OAuth/Magic Link callbacks in production
# Configure this exact URL in Supabase Dashboard -> Authentication -> URL Configuration -> Site URL
# VITE_SITE_URL=https://your-worknest-domain.vercel.app

# Optional: Application Performance & Error Monitoring (e.g., Sentry DSN)
# VITE_SENTRY_DSN=https://examplePublicKey@o0.ingest.sentry.io/0
